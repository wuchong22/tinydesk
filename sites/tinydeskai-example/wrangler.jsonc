{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Example config: resource names, domain and IDs are placeholders. Create your own resources and fill them in before deploying.
  "name": "tinydeskai-example",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Add your domain before deploying.
  "routes": [{ "pattern": "tinydeskai.tools", "custom_domain": true }],
  "vars": {
    "APP_URL": "https://tinydeskai.tools",
    "EMAIL_FROM": "noreply@tinydeskai.tools",
    // Rybbit collector URL, used only inside the Worker (/stats/* proxy); leave empty to disable.
    "RYBBIT_UPSTREAM": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinydeskai-example",
      "database_id": "dae881ef-8e04-4638-a39c-1125a7de6eb2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "OUTPUTS", "bucket_name": "tinydeskai-example-outputs" }],
  "send_email": [{ "name": "EMAIL" }],
  "workflows": [
    {
      "name": "tinydeskai-example-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow"
    }
  ],
  // Compose container (ffmpeg) needs the Workers Paid plan and a local Docker build.
  // Generation is closed until a model key exists, so this first deploy does not register the container.
  "dev": { "enable_containers": false }
}
