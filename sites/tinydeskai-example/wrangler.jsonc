{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Example config: resource names, domain and IDs are placeholders. Create your own resources and fill them in before deploying.
  "name": "tinydeskai-example",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Route on the existing proxied DNS. A Workers custom domain cannot replace the apex records already on the zone.
  "routes": [{ "pattern": "tinydeskai.tools/*", "zone_name": "tinydeskai.tools" }],
  "vars": {
    "APP_URL": "https://tinydeskai.tools",
    "EMAIL_FROM": "noreply@tinydeskai.tools",
    // Rybbit collector URL, used only inside the Worker (/stats/* proxy); leave empty to disable.
    "RYBBIT_UPSTREAM": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinydeskai-example",
      "database_id": "dae881ef-8e04-4638-a39c-1125a7de6eb2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "OUTPUTS", "bucket_name": "tinydeskai-example-outputs" }],
  "send_email": [{ "name": "EMAIL" }],
  "workflows": [
    {
      "name": "tinydeskai-example-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow"
    }
  ],
  // Effect compose container: ffmpeg image in packages/jobs/compose. Uses durable_object scheduling.
  // The instance type (standard-3) is set in start() in server.ts. sleepAfter is 5m, so an idle instance stops.
  // Public generation stays closed until PUBLIC_GENERATION is set to "1". A model key alone does not open it.
  // Purchases stay closed until PAYMENTS is set to "1" and both Stripe secrets exist. Do not set PAYMENTS here.
  "containers": [
    {
      "class_name": "ComposeContainer",
      "scheduling_policy": "durable_object",
      "images": { "compose": { "dockerfile": "../../packages/jobs/compose/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "COMPOSE", "class_name": "ComposeContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ComposeContainer"] }],
  // Local dev neither builds nor runs the container. Production deploy builds it with Docker.
  "dev": { "enable_containers": false }
}
